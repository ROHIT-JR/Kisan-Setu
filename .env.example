# Copy to .env for local dev. Never commit the real .env — this repo is public.

# --- General ---
ENV=development
VERSION=0.1.0

# --- Gemini (AI Studio, NO billing on this key's project) ---
# Hard rule: Flash/Flash-Lite only. A Pro model call will start charging.
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
# When true, gemini.py returns canned responses so teammates don't burn the
# ~1000 req/day free-tier quota during UI development.
MOCK_GEMINI=true
MAX_GEMINI_CALLS_PER_DAY=800

# --- GCP (Project A: billing linked, Vertex AI NOT enabled) ---
GCP_PROJECT_ID=kisan-setu-hackathon
GCP_REGION=us-central1

# --- Earth Engine (noncommercial, Community Tier) ---
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_KEY_PATH=

# --- Firestore ---
FIRESTORE_ENABLED=false

# --- CORS ---
CORS_ORIGINS=*
